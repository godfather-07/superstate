<section class="ss-page-hero">
  <div class="container">
    <span class="k">shop</span>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div style="color:#d5ddf3;max-width:560px;margin:0 auto">{{ collection.description }}</div>{%- endif -%}
  </div>
</section>
{%- paginate collection.products by 24 -%}
  <div class="ss-grid">
    {%- for product in collection.products -%}
      {%- render 'product-card', product: product -%}
    {%- else -%}
      <p>Nothing here yet.</p>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<div class="ss-page" style="text-align:center;padding-top:0">{{ paginate | default_pagination }}</div>{%- endif -%}
{%- endpaginate -%}

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
