{%- assign wa = settings.whatsapp_number | remove: ' ' | remove: '+' -%}
<section class="contact-hero fade-up">
  <div class="container">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 style="margin-bottom: 1rem;">{{ section.settings.title }}</h1>
    <p class="subheadline" style="margin: 0 auto;">{{ section.settings.sub }}</p>
  </div>
</section>

<section class="fade-up" style="padding-top: 0;">
  <div class="container">
    <div class="contact-grid">

      <div>
        <div class="contact-info">
          <h2 style="margin-bottom: 3rem;">How to reach us</h2>

          <div class="info-block">
            <span class="info-label">Email</span>
            <div class="info-value"><a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a></div>
          </div>

          <div class="info-block">
            <span class="info-label">WhatsApp &amp; Phone</span>
            <div class="info-value"><a href="https://wa.me/{{ wa }}">{{ settings.whatsapp_label | remove: ' ' }}</a></div>
          </div>

          <div class="info-block">
            <span class="info-label">Working Hours</span>
            <div class="info-value" style="font-weight: 400;">{{ section.settings.hours }}</div>
            <div style="font-size: 14px; color: #666; margin-top: 0.5rem;">{{ section.settings.hours_note }}</div>
          </div>

          <div class="info-block" style="margin-bottom: 0;">
            <span class="info-label">Address</span>
            <div class="info-value" style="font-weight: 400; line-height: 1.5;">{{ section.settings.address | newline_to_br }}</div>
          </div>
        </div>
      </div>

      <div class="contact-form-container">
        {%- form 'contact', id: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="ss-form-success" role="status">✓ Got it! A real person will reply soon, usually within a few hours.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="ss-form-errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="contact-form-grid">
            <div class="form-group" style="grid-column: 1 / -1;">
              <label class="form-label" for="cf-name">Name</label>
              <input id="cf-name" name="contact[name]" type="text" class="form-input" required autocomplete="name" maxlength="80" placeholder="Jane Doe" value="{{ form.name | default: customer.name }}">
            </div>

            <div class="form-group">
              <label class="form-label" for="cf-email">Email</label>
              <input id="cf-email" name="contact[email]" type="email" class="form-input" required autocomplete="email" placeholder="jane@example.com" value="{{ form.email | default: customer.email }}">
            </div>

            <div class="form-group">
              <label class="form-label" for="cf-phone">Phone <span class="cf-opt">(optional)</span></label>
              <input id="cf-phone" name="contact[phone]" type="tel" class="form-input" inputmode="tel" autocomplete="tel" maxlength="14" placeholder="9876543210" value="{{ form.phone }}">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="cf-reason">Reason for reaching out</label>
            <select id="cf-reason" name="contact[Reason]" class="form-select" required>
              <option value="General question" selected>General question</option>
              <option value="Order issue">Order issue</option>
              <option value="Product question">Product question</option>
              <option value="Creator / collab">Creator / collab</option>
              <option value="Media / press">Media / press</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="cf-order">Order number <span class="cf-opt">(if you have one)</span></label>
            <input id="cf-order" name="contact[Order number]" type="text" class="form-input" maxlength="60" placeholder="#1001">
          </div>

          <div class="form-group">
            <label class="form-label" for="cf-message">Message</label>
            <textarea id="cf-message" name="contact[body]" class="form-textarea" required maxlength="2000" placeholder="How can we help you today?">{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn btn-primary" id="cf-submit" style="width: 100%; margin-bottom: .75rem;">Send message</button>

          <div style="text-align: center;">
            <a href="https://wa.me/{{ wa }}" style="font-size: 15px; color: var(--success); font-weight: 500; text-decoration: underline;">
              Prefer WhatsApp? Chat with us directly →
            </a>
          </div>
        {%- endform -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "title", "label": "Title", "default": "Let's talk." },
    { "type": "text", "id": "sub", "label": "Sub-line", "default": "We respond to every message. Usually within 30 minutes." },
    { "type": "text", "id": "hours", "label": "Working hours", "default": "Monday–Saturday, 9am–7pm IST" },
    { "type": "text", "id": "hours_note", "label": "Hours note", "default": "We aim to reply within 30 minutes during working hours." },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Electronic City Phase 2,\nBengaluru, India" }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
