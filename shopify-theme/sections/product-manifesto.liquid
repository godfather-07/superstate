<!-- MANIFESTO -->
<section class="manifesto">
  <div class="container manifesto-inner">
    <span class="manifesto-tag">real talk ✶</span>
    <p class="manifesto-big">sleep is the <em class="marker">best supplement</em> in the whole world.</p>
    <p class="manifesto-mid">there's almost nothing a good night's sleep can't fix.</p>
    <p class="manifesto-soft">but deadlines, doomscrolling and 2am overthinking don't always let you have that luxury.</p>
    <ul class="manifesto-chips" aria-hidden="true">
      <li>📧 deadlines</li>
      <li>📱 doomscrolling</li>
      <li>🧠 2am overthinking</li>
      <li>☕ one coffee too many</li>
    </ul>
    <div class="manifesto-close-row">
      <p class="manifesto-close">so, <em>sleep well</em><br>with superstate<span class="moon"> ☾</span></p>
      <span class="manifesto-sticker" aria-hidden="true">coffee, but for sleep.</span>
    </div>
  </div>
</section>
