<section class="ss-page-hero" style="min-height:100vh;display:grid;place-items:center;padding:3rem 0">
  <div class="container">
    <img src="{{ 'logo-wordmark.png' | asset_url }}" alt="{{ shop.name | escape }}" width="200" height="42" style="height:auto;margin-bottom:1.5rem">
    <h1>{{ section.settings.title }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'ss-search-form' -%}
      <input type="hidden" name="contact[tags]" value="password-page">
      <input type="email" name="contact[email]" placeholder="your email" aria-label="Email" required>
      <button type="submit" class="ss-btn ss-btn-lime">Notify me</button>
      {%- if form.posted_successfully? -%}<p style="width:100%;margin-top:.75rem;color:#E4FF5A">✓ you're on the list.</p>{%- endif -%}
    {%- endform -%}
    {%- form 'storefront_password', class: 'ss-search-form' -%}
      <input type="password" name="password" placeholder="store password" aria-label="Store password">
      <button type="submit" class="ss-btn ss-btn-ghost" style="color:#fff !important;border-color:#fff">Enter</button>
      {%- if form.errors -%}<p style="width:100%;margin-top:.75rem;color:#fecaca">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password page", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "something good is brewing ☾" } ] }
{% endschema %}
