  <!-- SECTION 5 — CLOSING THE GAP (animated venn) -->
  <section class="gap-section" id="close-the-gap">
    <div class="container gap-grid">
      <div class="gap-copy">
        <span class="gap-tag">our whole thing ✶</span>
        <h2 class="gap-title">we're making health <em>easier</em> to understand.</h2>
        <p class="gap-text">most of us have no idea what's actually in the stuff we use every day. we're closing that gap, one honest label at a time.</p>
      </div>

      <div class="gap-visual" aria-label="Two circles, what you use and what you know, moving together to overlap">
        <span class="gap-note" aria-hidden="true">we're trying to<br>close the gap ↓</span>
        <div class="gap-stage">
          <div class="gap-circle gap-use"><span>what<br>you use</span></div>
          <div class="gap-circle gap-know"><span>what<br>you know</span></div>
          <span class="gap-sticker">you, informed ✨</span>
        </div>
      </div>
    </div>
  </section>

  <style>
    .gap-section {
      background: #E4FF5A;
      color: #003399;
      padding: 5rem 0;
      overflow: hidden;
    }
    .gap-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
    }
    .gap-tag {
      display: inline-block;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: 1.5px solid #003399;
      border-radius: 999px;
      padding: 0.35rem 0.85rem;
      margin-bottom: 1.5rem;
    }
    .gap-title {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 800;
      font-size: clamp(31px, 4.29vw, 59px);
      line-height: 0.95;
      letter-spacing: -0.045em;
      color: #003399;
      margin: 0 0 1.25rem;
      text-transform: lowercase;
    }
    .gap-title em {
      font-family: 'Instrument Serif', serif;
      font-weight: 400;
      font-style: italic;
      letter-spacing: -0.01em;
      background: linear-gradient(transparent 58%, #ffffff 58%, #ffffff 92%, transparent 92%);
      padding: 0 0.08em;
    }
    .gap-text {
      font-size: clamp(17px, 1.6vw, 20px);
      line-height: 1.55;
      font-weight: 600;
      max-width: 34ch;
      margin: 0;
    }
    .gap-visual {
      position: relative;
      padding-top: 3.5rem;
    }
    .gap-note {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%) rotate(-3deg);
      font-family: 'Caveat', cursive;
      font-size: 24px;
      font-weight: 700;
      line-height: 1.05;
      text-align: center;
      color: #003399;
      white-space: nowrap;
    }
    .gap-stage {
      position: relative;
      height: clamp(240px, 30vw, 360px);
    }
    .gap-circle {
      position: absolute;
      top: 50%;
      width: clamp(200px, 26vw, 320px);
      aspect-ratio: 1;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 800;
      font-size: clamp(22px, 2.6vw, 34px);
      line-height: 1;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .gap-use {
      left: 50%;
      background: #ffffff;
      color: #003399;
      transform: translate(-118%, -50%) rotate(-6deg);
      box-shadow: 0 18px 40px rgba(0, 51, 153, 0.18);
    }
    .gap-know {
      left: 50%;
      background: rgba(0, 51, 153, 0.9);
      color: #E4FF5A;
      transform: translate(18%, -50%) rotate(6deg);
      box-shadow: 0 18px 40px rgba(0, 51, 153, 0.25);
    }
    .gap-use span { transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1); }
    .gap-know span { transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1); }
    .gap-section.closed .gap-use {
      transform: translate(-84%, -50%) rotate(-3deg);
    }
    .gap-section.closed .gap-know {
      transform: translate(-16%, -50%) rotate(3deg);
    }
    /* keep each label in the part of its circle that doesn't overlap */
    .gap-section.closed .gap-use span { transform: translateX(-26%); }
    .gap-section.closed .gap-know span { transform: translateX(26%); }
    .gap-sticker {
      position: absolute;
      left: 50%;
      top: 84%;
      z-index: 2;
      transform: translate(-50%, -50%) rotate(-8deg) scale(0.4);
      opacity: 0;
      background: #E4FF5A;
      color: #003399;
      border: 2px solid #003399;
      font-family: 'Instrument Serif', serif;
      font-style: italic;
      font-size: clamp(16px, 1.8vw, 22px);
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      white-space: nowrap;
      box-shadow: 0 8px 18px rgba(0, 51, 153, 0.25);
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.1s, opacity 0.3s ease 1.1s;
    }
    .gap-section.closed .gap-sticker {
      transform: translate(-50%, -50%) rotate(-8deg) scale(1);
      opacity: 1;
    }
    @media (max-width: 860px) {
      .gap-section {
        padding: 4rem 0;
      }
      .gap-grid {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 1.5rem;
      }
      .gap-text {
        margin: 0 auto;
      }
      .gap-circle {
        width: min(46vw, 210px);
        font-size: clamp(17px, 5vw, 22px);
      }
      .gap-stage {
        height: min(54vw, 240px);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .gap-circle, .gap-circle span, .gap-sticker { transition: none; }
    }
  </style>

  <script>
    // Slide the two circles together when the section comes into view
    (() => {
      const section = document.getElementById("close-the-gap");
      if (!section) return;
      if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        section.classList.add("closed");
        return;
      }
      new IntersectionObserver((entries, obs) => {
        if (entries[0].isIntersecting) {
          section.classList.add("closed");
          obs.disconnect();
        }
      }, { threshold: 0.45 }).observe(section);
    })();
  </script>

