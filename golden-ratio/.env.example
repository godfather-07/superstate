# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Canonical site URL (used for metadata, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://www.thegoldnratio.com

# Calendly — the 30-minute discovery call event
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/goldnratio/discovery

# Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=

# Sanity CMS (optional — the site uses src/lib/content.ts until these are set)
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=your_token

# Contact form email (Resend). RESEND_FROM must be on a domain verified in Resend.
RESEND_API_KEY=your_key
RESEND_FROM=Golden Ratio <studio@thegoldnratio.com>
CONTACT_EMAIL=george@thegoldnratio.com
