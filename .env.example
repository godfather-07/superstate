# Apps Script Web App URL that appends waitlist submissions to the
# "Influencer Waitlist Responses" Google Sheet.
# See google-apps-script/waitlist-webhook.gs for the deployment steps.
# Optional: a default deployment URL is already baked into
# src/services/waitlistService.js, so this only needs setting if the
# script is ever redeployed to a new URL.
VITE_WAITLIST_SHEET_URL=

# Razorpay Standard Checkout (see api/create-order.js, api/verify-payment.js)
# Server-only. Set these in Vercel -> Project -> Settings -> Environment Variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public key id used by the browser checkout. Same value as RAZORPAY_KEY_ID.
VITE_RAZORPAY_KEY_ID=
# Optional: the Apps Script URL the server uses to log paid pre-bookings
# (defaults to the same URL as VITE_WAITLIST_SHEET_URL / the baked-in one).
SHEET_WEBHOOK_URL=
