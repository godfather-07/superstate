# Apps Script Web App URL that appends waitlist submissions to the
# "Influencer Waitlist Responses" Google Sheet.
# See google-apps-script/waitlist-webhook.gs for the deployment steps.
# Optional: a default deployment URL is already baked into
# src/services/waitlistService.js, so this only needs setting if the
# script is ever redeployed to a new URL.
VITE_WAITLIST_SHEET_URL=
